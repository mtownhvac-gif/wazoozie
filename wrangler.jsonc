{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wazoozie",
  "account_id": "3ad8f68ca56ff4def783a772157a9012",
  "compatibility_date": "2026-11-04",
  "keep_vars": true,
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wazoozie.com",
      "custom_domain": true
    },
    {
      "pattern": "www.wazoozie.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "entry.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "PROJECT_INBOX",
        "class_name": "ProjectInbox"
      },
      {
        "name": "HOME_ACCOUNTS",
        "class_name": "HomeAccounts"
      }
    ]
  },
  "migrations": [
    {
      "tag": "project-inbox-v1",
      "new_sqlite_classes": [
        "ProjectInbox"
      ]
    },
    {
      "tag": "home-accounts-v1",
      "new_sqlite_classes": [
        "HomeAccounts"
      ]
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
