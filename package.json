{
  "name": "wazoozie",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 build.py",
    "build:production": "PUBLIC_SITE_URL=https://wazoozie.com python3 build.py",
    "check": "python3 check_site.py && python3 -m unittest discover -s tests -p 'test_*.py' && python3 check_contact.py && node check_agent.mjs && node --test tests/*.test.mjs",
    "check:live-alerts": "node scripts/check_live_alerts.mjs",
    "dev": "node scripts/dev.mjs",
    "deploy": "npm run build:production && npm run check && wrangler deploy --keep-vars",
    "check:live-search": "python3 scripts/check_live_search.py",
    "notify:search": "python3 scripts/submit_indexnow.py --submit"
  },
  "devDependencies": {
    "jsdom": "^27.2.0",
    "miniflare": "5.20261103.0-beta",
    "wrangler": "4.157.0"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3"
  }
}
