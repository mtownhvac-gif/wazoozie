{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wazoozie",
  "account_id": "3ad8f68ca56ff4def783a772157a9012",
  "compatibility_date": "2026-11-04",
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    {"pattern": "wazoozie.com", "custom_domain": true},
    {"pattern": "www.wazoozie.com", "custom_domain": true}
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
